# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=espace
DB_USER=root
DB_PASS=

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Application Configuration
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost/eSpace/backend/public
APP_NAME=eSpace
FRONTEND_URL=http://localhost:3000

# Security
APP_KEY=
SESSION_LIFETIME=7200
CSRF_TOKEN_NAME=csrf_token

# File Storage
STORAGE_PATH=../storage
UPLOADS_PATH=../uploads
MAX_UPLOAD_SIZE=52428800

# BigBlueButton
BBB_SERVER_URL=
BBB_SECRET=

# ElevenLabs (AI voice narration for eNotes)
ELEVENLABS_API_KEY=

# Google Gemini (AI Tutor explanations for eNotes)
GEMINI_API_KEY=

# Email (if needed)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@espace.com
MAIL_FROM_NAME=eSpace
