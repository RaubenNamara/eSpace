# Prevent execution of any script inside the uploads directory. php_flag is only a valid directive
# when mod_php is handling PHP, so it's guarded here - on PHP-via-LSAPI/php-fpm setups (as used in
# production), an unguarded php_flag isn't a recognized directive and makes Apache 500 on every
# request under this directory. The FilesMatch block below is the real protection either way.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

<FilesMatch "\.(php|php\d|phtml|phar|pl|py|cgi|sh)$">
    Require all denied
</FilesMatch>

# Every uploaded file's name already encodes a content hash + timestamp (see the upload
# controllers - a re-upload/replacement always gets a brand new filename), so a URL here never
# changes its content. Cache aggressively: reopening a document (eLibrary/Item Bank preview,
# recently-added shelf, etc.) then loads instantly from the browser's disk cache instead of
# re-downloading the whole file over the network every time.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType application/pdf "access plus 1 year"
    ExpiresByType application/vnd.openxmlformats-officedocument.presentationml.presentation "access plus 1 year"
    ExpiresByType application/vnd.ms-powerpoint "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType video/mp4 "access plus 1 year"
    ExpiresByType video/webm "access plus 1 year"
    ExpiresByType video/ogg "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(pdf|ppt|pptx|jpg|jpeg|png|webp|gif|mp4|webm|ogv)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>