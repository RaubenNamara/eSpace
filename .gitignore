# Dependencies
node_modules/
vendor/

# Environment files - .env.example is the only one meant to be tracked (placeholders only,
# see backend/.env.example); every other .env variant holds real credentials for some
# environment (backend/.env is local dev, backend/.env.production holds live production
# secrets - DB password, BigBlueButton secret, ElevenLabs/Gemini API keys) and must never be
# committed.
.env
.env.local
.env.*.local
.env.production
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
php_errors.log

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Build outputs
dist/
build/
*.cache

# Uploads (keep structure, ignore content) - the real upload directory backend/public/uploads/
# holds actual student/teacher-submitted files (assignment answers, chat media, profile
# photos, e-note narration audio); backend/uploads/ below is a second, currently-empty
# directory kept excluded too in case it's ever used.
backend/uploads/*/*
!backend/uploads/.gitkeep
backend/public/uploads/*/*
!backend/public/uploads/.gitkeep
!backend/public/uploads/.htaccess
storage/*/*
!storage/.gitkeep

# Database
*.sql
!database/schema.sql
!database/migrations/*.sql

# Session files
backend/sessions/
*.sess

# Temporary files
tmp/
temp/
*.tmp

# Ad-hoc debug/check/test scripts left in the backend during development (not part of the
# app - nothing under routes/api.php references these). Several found here dumped password
# hashes or reset the admin password with zero auth; keep this whole class of file out of
# version control rather than trying to allowlist "safe" ones by hand.
backend/check_*.php
backend/test_*.php
backend/debug_*.php
backend/fix_*.php
backend/scratch_*.php
backend/database/migrations/check_*.php
backend/migrations/fix_*.php
backend/public/check_*.php
backend/public/test_*.php
backend/public/debug_*.php
backend/public/clear_lockout.php
/check_*.php
/test_*.php
/debug_*.php
/scratch_*.php
/fix_*.php
/run_migration.php
backend/run_migration*.php

# Vite writes these when it has to reload its own config mid-run; harmless, regenerated freely
frontend/vite.config.ts.timestamp-*.mjs

# Stray root-level uploads stub, unrelated to the real backend/public/uploads/
/public/

# Composer
composer.lock

# Package manager
package-lock.json
yarn.lock
