# eSpace production deployment - public_html/eSpace/
#
# Layout this expects, side by side under public_html/eSpace/:
#   index.html, assets/, manifest.webmanifest, registerSW.js, sw.js, images/, ...  (this dist/ build)
#   backend/                                                                        (uploaded separately, unchanged)
#
# Four jobs, in order: (1) let real requests into backend/ pass through untouched so its own
# .htaccess/front-controller still handles them exactly as it does today, (2) alias the clean
# /eSpace/api/... URL the frontend calls onto the backend's front controller, (3) alias the clean
# /eSpace/uploads/... URL (built by frontend/src/utils/url.ts's resolveAssetUrl - videos, chat
# attachments, profile photos, eNote narration audio, school logos, etc.) straight onto the real
# uploaded files, so they're served directly rather than 404ing/hitting the SPA fallback below,
# (4) serve any existing static file/directory as-is, otherwise fall back to index.html so Vue
# Router's history mode keeps working on a hard refresh of a route like /eSpace/student/dashboard.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # eSpace's address is https://tusome.ug. The old address (and the cPanel helper subdomain the
  # addon domain sits on) send every path there permanently, and plain http goes to https.
  # Certificate checks under /.well-known/ are left alone so AutoSSL renewals keep working.
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTP_HOST} ^(espace|tusome)\.stmark\.sc\.ug$ [NC]
  RewriteRule ^(.*)$ https://tusome.ug/$1 [R=301,L]
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTP_HOST} ^(www\.)?tusome\.ug$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://tusome.ug/$1 [R=301,L]

  # If the docroot points straight at this folder itself (e.g. a subdomain whose docroot is set
  # to public_html/eSpace, rather than public_html one level up), incoming requests still carry
  # the leading "eSpace/" segment baked into every URL by Vite's base: '/eSpace/' config. Strip it
  # here so the rules below - which assume that segment is already gone, as it is when the docroot
  # is one level up - work the same regardless of which docroot depth this got deployed under.
  RewriteRule ^eSpace/(.*)$ $1 [L]

  # Requests under backend/ (e.g. someone hitting it directly, or the LiveClassController BBB
  # return URL) are left completely alone - backend/public/.htaccess owns that space already.
  RewriteRule ^backend/ - [L]

  # Clean API alias: /eSpace/api/* -> the backend's own front controller. (Backend/app/Routes/Router.php
  # resolves this correctly - see its getRequestUri() /api anchor fallback.)
  RewriteRule ^api/(.*)$ backend/public/index.php [L]

  # Clean uploads alias: /eSpace/uploads/* -> the real files under backend/public/uploads/*.
  RewriteRule ^uploads/(.*)$ backend/public/uploads/$1 [L]

  # Any file or directory that actually exists (assets/*.js, *.css, manifest.webmanifest,
  # registerSW.js, sw.js, images/*, favicon, fonts, etc.) is served directly - never rewritten.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else is a Vue Router route (e.g. student/dashboard) - hand it to the SPA shell.
  RewriteRule ^ index.html [L]
</IfModule>

# Static assets are content-hashed by Vite - safe to cache aggressively.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|ttf|eot|svg|png|jpg|jpeg|gif|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(index\.html|manifest\.webmanifest|registerSW\.js|sw\.js|push-sw\.js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Anatomy models (anatomy/bodyparts3d/*.glb) and their manifest.json keep the same name across
  # releases, so not "immutable": reused for a day, then refreshed in the background for a week
  # while the cached copy is shown - repeat visits don't wait on the network for them.
  <FilesMatch "(\.glb|^manifest\.json)$">
    Header set Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
  </FilesMatch>
  # The developer portal is for the Tusome team: search engines must never list it. Checked on
  # the original request line, since the address is rewritten to index.html further up. (Not in
  # robots.txt - that would stop crawlers from seeing this, and would publish the address.)
  <If "%{THE_REQUEST} =~ m#\s/(eSpace/)?devportal#">
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  </If>
</IfModule>
<IfModule mod_mime.c>
  AddType model/gltf-binary .glb
</IfModule>

# Compress text responses. The live server was sending everything uncompressed - the ~1.4MB
# CKEditor bundle the eNote builder needs went over the wire at full size, which made opening a
# topic slow on school connections. gzip cuts JS/CSS/JSON to roughly a quarter.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml image/svg+xml
  AddOutputFilterByType DEFLATE application/javascript text/javascript application/json application/manifest+json
  # the anatomy models: meshopt-packed already, gzip still takes ~30% off
  AddOutputFilterByType DEFLATE model/gltf-binary
</IfModule>

Options -Indexes

# The two blocks below are cPanel's own (MultiPHP / PHP 8.2 handler) copied from the live server,
# so a git deploy that copies dist/ over public_html/eSpace/ never drops them and breaks PHP.

# BEGIN cPanel-generated php ini directives, do not edit
# Manual editing of this file may result in unexpected behavior.
# To make changes to this file, use the cPanel MultiPHP INI Editor (Home >> Software >> MultiPHP INI Editor)
# For more information, read our documentation (https://go.cpanel.net/EA4ModifyINI)
<IfModule php8_module>
   php_value error_log "/home/smacon/logs/php.error.log"
   php_flag log_errors On
</IfModule>
<IfModule lsapi_module>
   php_value error_log "/home/smacon/logs/php.error.log"
   php_flag log_errors On
</IfModule>
# END cPanel-generated php ini directives, do not edit

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php82” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
